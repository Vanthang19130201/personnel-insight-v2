diff --git a/src/main/resources/static/residence-rank-report.js b/src/main/resources/static/residence-rank-report.js
new file mode 100644
--- /dev/null
+++ b/src/main/resources/static/residence-rank-report.js
+'use strict';
+
+/*
+ * Personnel Insight - bổ sung:
+ * 1) Nơi ở hiện nay (xã/phường) cho từng hồ sơ.
+ * 2) Tổng hợp quân hàm/cấp bậc.
+ * 3) Bảng "XII. Nơi ở hiện nay" dạng 2 cặp cột giống mẫu báo cáo.
+ *
+ * File này tách riêng để hạn chế sửa app.js hiện tại.
+ */
+
+const _baseCleanPerson = cleanPerson;
+cleanPerson = function(p) {
+  const cleaned = _baseCleanPerson(p);
+  if (!cleaned) return null;
+  cleaned.residence = safeText(p?.residence, 70).replace(/\s+/g, ' ');
+  return cleaned;
+};
+
+const _baseOpenForm = openForm;
+openForm = function(id = null) {
+  _baseOpenForm(id);
+  const form = byId('personForm');
+  if (!form?.elements?.residence) return;
+  const p = id ? people.find(x => x.id === id) : null;
+  form.elements.residence.value = p?.residence || '';
+};
+
+function residenceRows() {
+  const map = new Map();
+  people.forEach(p => {
+    const label = String(p.residence || '').trim() || 'Chưa cập nhật';
+    map.set(label, (map.get(label) || 0) + 1);
+  });
+  return [...map.entries()].sort((a, b) => {
+    if (a[0] === 'Chưa cập nhật') return 1;
+    if (b[0] === 'Chưa cập nhật') return -1;
+    return a[0].localeCompare(b[0], 'vi');
+  });
+}
+
+function rankRowsForReport() {
+  const map = new Map();
+  people.forEach(p => {
+    const label = String(p.rank || '').trim() || 'Chưa cập nhật';
+    map.set(label, (map.get(label) || 0) + 1);
+  });
+  return [...map.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'vi'));
+}
+
+function pairedSummaryTable(title, rows, leftLabel) {
+  const normalized = rows.length ? rows : [['Chưa có dữ liệu', 0]];
+  let body = '';
+  for (let i = 0; i < normalized.length; i += 2) {
+    const left = normalized[i];
+    const right = normalized[i + 1];
+    body += `<tr>
+      <td>${esc(left[0])}</td>
+      <td class="summary-number">${fmt(left[1])}</td>
+      <td>${right ? esc(right[0]) : ''}</td>
+      <td class="summary-number">${right ? fmt(right[1]) : ''}</td>
+    </tr>`;
+  }
+  return `<section class="panel report-summary-panel">
+    <h2>${esc(title)}</h2>
+    <p class="panel-sub">Tự động tổng hợp từ hồ sơ nhân sự đã nhập.</p>
+    <div class="table-scroll">
+      <table class="data-table paired-summary-table">
+        <thead>
+          <tr>
+            <th>${esc(leftLabel)}</th><th>Q.số</th>
+            <th>${esc(leftLabel)}</th><th>Q.số</th>
+          </tr>
+        </thead>
+        <tbody>${body}</tbody>
+      </table>
+    </div>
+  </section>`;
+}
+
+/* Thêm cột nơi ở vào danh sách hồ sơ. */
+personRow = function(p, actions = true) {
+  return `<tr>
+    <td><span class="mini-muted">${esc(p.code)}</span></td>
+    <td><div class="person-cell"><span class="initials">${esc(p.name.trim().split(/\s+/).slice(-2).map(x=>x[0]).join('').toUpperCase())}</span><div><strong>${esc(p.name)}</strong><small>${esc(p.rank)} · ${esc(p.group)}</small></div></div></td>
+    <td>${dateAge(p.dob) ?? '—'}</td>
+    <td><span class="pill">${esc(p.education)}</span></td>
+    <td>${esc(p.marital)}</td>
+    <td>${esc(p.position)}</td>
+    <td>${esc(p.residence || '—')}</td>
+    <td><strong>${vnMoney(revenue(p))}</strong></td>
+    ${actions ? `<td><div class="actions"><button class="small-action" data-action="edit" data-id="${esc(p.id)}">Sửa</button><button class="small-action danger" data-action="remove" data-id="${esc(p.id)}">Xóa</button></div></td>` : ''}
+  </tr>`;
+};
+
+personTable = function(list, actions = true) {
+  return `<div class="table-scroll"><table class="data-table">
+    <thead><tr><th>Mã</th><th>Họ tên / quân hàm</th><th>Tuổi</th><th>Văn hóa</th><th>Hôn nhân</th><th>Chức vụ</th><th>Nơi ở hiện nay</th><th>Thu nhập/tháng</th>${actions ? '<th>Thao tác</th>' : ''}</tr></thead>
+    <tbody>${list.length ? list.map(p => personRow(p, actions)).join('') : `<tr><td colspan="${actions ? 9 : 8}" class="empty">Không có hồ sơ phù hợp.</td></tr>`}</tbody>
+  </table></div>`;
+};
+
+/* Bổ sung thống kê nơi ở vào Thống kê chuyên sâu. Cấp bậc đã có sẵn trong app.js. */
+const _baseRenderStatistics = renderStatistics;
+renderStatistics = function() {
+  _baseRenderStatistics();
+  byId('main').insertAdjacentHTML('beforeend',
+    `<div class="grid-two residence-rank-extra">
+      ${metricPanel('Nơi ở hiện nay theo xã/phường', 'Tổng hợp tự động từ trường Nơi ở hiện nay', residenceRows(), 'gold')}
+      ${metricPanel('Tổng hợp quân hàm / cấp bậc', 'Đếm theo quân hàm được nhập trong từng hồ sơ', rankRowsForReport(), 'blue')}
+    </div>`
+  );
+};
+
+/* Ghi đè phần Tổng hợp theo mẫu báo cáo để có bảng giống mẫu Word. */
+renderTemplateReport = function() {
+  const count = people.length;
+  const forty = people.filter(p => {
+    const a = dateAge(p.dob);
+    return a !== null && a >= 40 && a <= 45;
+  }).length;
+  const e12 = people.filter(p => p.education === '12/12').length;
+  const party = people.filter(p => p.organization === 'Đảng viên').length;
+  const married = people.filter(p => p.marital === 'Đã kết hôn').length;
+
+  const groups = dynamicRows(p => p.category);
+  const religion = dynamicRows(p => p.religion);
+  const ethnicity = dynamicRows(p => p.ethnicity);
+  const eduRows = dynamicRows(p => p.education);
+  const org = dynamicRows(p => p.organization);
+
+  const ageRows = ['18–20','21–22','23–24','25–29','30–34','35–39','40–45','46–54','55+'].map((label, i) => {
+    const bands = [[18,20],[21,22],[23,24],[25,29],[30,34],[35,39],[40,45],[46,54],[55,110]];
+    return [label, people.filter(p => {
+      const a = dateAge(p.dob);
+      return a !== null && a >= bands[i][0] && a <= bands[i][1];
+    }).length];
+  });
+
+  byId('main').innerHTML =
+    hero(
+      'Tổng hợp theo mẫu báo cáo',
+      'Tự động tổng hợp quân số, quân hàm và nơi ở hiện nay từ hồ sơ đã nhập.',
+      `<button class="btn btn-primary" data-action="add">＋ Thêm hồ sơ</button><button class="btn btn-light" data-action="print">▤ In báo cáo</button>`
+    )
+    + `<section class="stats-grid">
+        ${metric('♙','Quân số đã nhập',fmt(count),'Tính từ database')}
+        ${metric('◷','Độ tuổi 40–45',fmt(forty),'Tính từ ngày sinh')}
+        ${metric('▤','Học vấn 12/12',fmt(e12),'Tính từ hồ sơ')}
+        ${metric('◎','Đảng viên',fmt(party),'Theo ô Đảng / Đoàn')}
+      </section>`
+    + `${count === 0 ? '<div class="welcome-empty"><div class="welcome-mark">▤</div><div><strong>Chưa có hồ sơ để lập báo cáo</strong><p>Hãy thêm nhân sự trong mục Hồ sơ nhân sự.</p></div></div>' : ''}`
+    + `<div class="grid-two">
+        ${dynamicSourceSection('I. Thành phần quân số', groups)}
+        ${pairedSummaryTable('II. Quân hàm / cấp bậc', rankRowsForReport(), 'Quân hàm')}
+        ${dynamicSourceSection('III. Dân tộc', ethnicity)}
+        ${dynamicSourceSection('IV. Tôn giáo', religion)}
+        ${dynamicSourceSection('V. Học vấn', eduRows)}
+        ${dynamicSourceSection('VI. Đảng, Đoàn', org)}
+        ${dynamicSourceSection('VII. Độ tuổi', ageRows)}
+        ${dynamicSourceSection('VIII. Hôn nhân', dynamicRows(p => p.marital))}
+        ${dynamicSourceSection('IX. Hoàn cảnh gia đình (phân loại chung)', dynamicRows(p => p.family))}
+        ${dynamicSourceSection('X. Chức vụ', dynamicRows(p => p.position))}
+      </div>`
+    + pairedSummaryTable('XII. NƠI Ở HIỆN NAY', residenceRows(), 'Xã / phường')
+    + `<section class="panel">
+        <h2>Bảng tóm tắt có thể in</h2>
+        <div class="report-grid">
+          <div><b>${fmt(count)} người</b><small>Tổng số hồ sơ</small></div>
+          <div><b>${fmt(rankRowsForReport().filter(([k]) => k !== 'Chưa cập nhật').reduce((s,[,n]) => s+n,0)} người</b><small>Đã nhập quân hàm</small></div>
+          <div><b>${fmt(residenceRows().filter(([k]) => k !== 'Chưa cập nhật').reduce((s,[,n]) => s+n,0)} người</b><small>Đã nhập nơi ở</small></div>
+          <div><b>${fmt(married)} người</b><small>Đã kết hôn</small></div>
+          <div><b>${fmt(sum(people,'children'))}</b><small>Tổng số con khai báo</small></div>
+          <div><b>${vnMoney(sum(people,'salary') + sum(people,'allowance'))}</b><small>Tổng thu nhập tháng</small></div>
+        </div>
+        <p class="footer-note">Ngày tạo: ${new Date().toLocaleDateString('vi-VN')}. Toàn bộ số liệu được tính từ hồ sơ trong database.</p>
+      </section>`;
+};
+
+/* CSV có thêm cột Nơi ở hiện nay. */
+exportCsv = function() {
+  const cols = [
+    ['code','Mã nhân sự'],['name','Họ và tên'],['dob','Ngày sinh'],['gender','Giới tính'],
+    ['group','Nhóm'],['rank','Quân hàm / cấp bậc'],['position','Chức vụ'],['residence','Nơi ở hiện nay'],
+    ['education','Trình độ văn hóa'],['qualification','Trình độ chuyên môn'],['marital','Hôn nhân'],
+    ['category','Đối tượng'],['ethnicity','Dân tộc'],['religion','Tôn giáo'],
+    ['organization','Đảng / Đoàn'],['family','Hoàn cảnh gia đình (khái quát)'],
+    ['children','Số con'],['years','Thâm niên'],['salary','Lương tháng'],['allowance','Phụ cấp'],['note','Ghi chú']
+  ];
+  const cell = x => '"' + String(x ?? '').replaceAll('"','""').replace(/^[\s]*[=+@\-\u2212]/, '\u0027$&') + '"';
+  const rows = [
+    cols.map(c => cell(c[1])).join(','),
+    ...people.map(p => cols.map(([k]) => cell(p[k])).join(','))
+  ];
+  download('personnel-insight-data.csv', rows.join('\r\n'), 'text/csv;charset=utf-8');
+  notify('Đã xuất CSV có nơi ở hiện nay.');
+};
