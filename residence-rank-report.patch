+++ b/src/main/resources/static/residence-rank-report.css
+.paired-summary-table th:nth-child(2),
+.paired-summary-table th:nth-child(4),
+.paired-summary-table td:nth-child(2),
+.paired-summary-table td:nth-child(4){
+  width:90px;
+  text-align:center;
+}
+.paired-summary-table .summary-number{
+  font-weight:800;
+  color:#173a32;
+}
+.report-summary-panel h2{
+  text-transform:none;
+}
+@media print{
+  .paired-summary-table{
+    font-size:11pt;
+  }
+  .paired-summary-table th,
+  .paired-summary-table td{
+    border:1px solid #222 !important;
+  }
+}
